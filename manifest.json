{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Offcut",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "author": "Ömer Faruk Ceylandağ",
  "homepage_url": "https://github.com/team886/offcut",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://chat.deepseek.com/*",
    "https://chat.mistral.ai/*",
    "https://grok.com/*",
    "https://copilot.microsoft.com/*",
    "https://www.kimi.com/*",
    "https://chat.qwen.ai/*",
    "https://chat.z.ai/*",
    "https://t3.chat/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/chat/*",
        "https://claude.ai/project/*",
        "https://chatgpt.com/c/*",
        "https://gemini.google.com/app/*",
        "https://www.perplexity.ai/search/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://grok.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.kimi.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.z.ai/*",
        "https://t3.chat/*"
      ],
      "js": [
        "src/parse.js",
        "src/zip.js",
        "src/registry.js",
        "src/adapters/common-dom.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/panel.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/panel.html?options=1",
    "open_in_tab": true
  },
  "commands": {
    "download-current": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "__MSG_cmdDownload__"
    }
  }
}
